<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Générateur de Landing Page</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .loading {
            display: none;
        }
        .result-container {
            display: none;
            margin-top: 20px;
        }
        .generated-content {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
            padding: 1rem;
            max-height: 400px;
            overflow-y: auto;
            font-family: 'Courier New', monospace;
            font-size: 0.9em;
        }
        .debug-info {
            background-color: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 0.375rem;
            padding: 1rem;
            margin-top: 10px;
            font-size: 0.8em;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="card">
                    <div class="card-header">
                        <h2 class="text-center">Générateur de Landing Page avec ChatGPT</h2>
                        <p class="text-center text-muted mb-0">Utilise l'API ChatGPT pour générer des landing pages</p>
                    </div>
                    <div class="card-body">
                        <form id="landingPageForm">
                            <div class="mb-3">
                                <label for="prompt" class="form-label">Décrivez votre landing page :</label>
                                <textarea 
                                    class="form-control" 
                                    id="prompt" 
                                    name="prompt" 
                                    rows="4" 
                                    placeholder="Ex: une application de fitness avec un design moderne, des couleurs vives, une section héros, des témoignages et un call-to-action pour télécharger l'app"
                                    required
                                ></textarea>
                                <div class="form-text">Le système ajoutera automatiquement les instructions pour générer du HTML/CSS.</div>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">
                                    <span class="button-text">Générer la Landing Page</span>
                                    <span class="loading">
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        Génération en cours...
                                    </span>
                                </button>
                            </div>
                        </form>

                        <div id="resultContainer" class="result-container">
                            <h4>Code généré :</h4>
                            <div id="generatedContent" class="generated-content"></div>
                            <div class="mt-3">
                                <button id="copyButton" class="btn btn-secondary">Copier le code</button>
                                <button id="previewButton" class="btn btn-info">Prévisualiser</button>
                                <button id="toggleDebug" class="btn btn-outline-warning btn-sm">Voir les détails de réponse</button>
                            </div>
                            <div id="debugInfo" class="debug-info" style="display: none;"></div>
                        </div>

                        <div id="errorContainer" class="alert alert-danger" style="display: none;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal pour la prévisualisation -->
    <div class="modal fade" id="previewModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Prévisualisation de la Landing Page</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <iframe id="previewFrame" style="width: 100%; height: 600px; border: none;"></iframe>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let lastResponse = null;

        document.getElementById('landingPageForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const prompt = document.getElementById('prompt').value;
            const button = document.querySelector('button[type="submit"]');
            const buttonText = button.querySelector('.button-text');
            const loading = button.querySelector('.loading');
            const resultContainer = document.getElementById('resultContainer');
            const errorContainer = document.getElementById('errorContainer');
            
            // Afficher le loading
            buttonText.style.display = 'none';
            loading.style.display = 'inline';
            button.disabled = true;
            
            // Cacher les résultats précédents
            resultContainer.style.display = 'none';
            errorContainer.style.display = 'none';
            
            try {
                const formData = new FormData();
                formData.append('prompt', prompt);
                
                const response = await fetch('/api/generate-landing-page', {
                    method: 'POST',
                    body: formData
                });
                
                const data = await response.json();
                lastResponse = data; // Stocker pour debug
                
                if (data.status === 'success') {
                    // Traiter la réponse ChatGPT
                    let generatedText = '';
                    
                    // La structure de réponse peut varier, on essaie différentes approches
                    if (data.content && data.content.message && data.content.message.content) {
                        generatedText = data.content.message.content.parts ? 
                            data.content.message.content.parts.join('') : 
                            data.content.message.content;
                    } else if (data.content && typeof data.content === 'string') {
                        generatedText = data.content;
                    } else {
                        // Si la structure est différente, on affiche la réponse brute
                        generatedText = JSON.stringify(data.content, null, 2);
                    }
                    
                    document.getElementById('generatedContent').textContent = generatedText;
                    document.getElementById('debugInfo').textContent = JSON.stringify(data.raw_response, null, 2);
                    resultContainer.style.display = 'block';
                } else {
                    throw new Error(data.message || 'Erreur inconnue');
                }
                
            } catch (error) {
                console.error('Erreur complète:', error);
                errorContainer.innerHTML = `
                    <strong>Erreur:</strong> ${error.message}<br>
                    <small>Vérifiez la console pour plus de détails</small>
                `;
                errorContainer.style.display = 'block';
            } finally {
                // Cacher le loading
                buttonText.style.display = 'inline';
                loading.style.display = 'none';
                button.disabled = false;
            }
        });
        
        // Fonction pour copier le code
        document.getElementById('copyButton').addEventListener('click', function() {
            const content = document.getElementById('generatedContent').textContent;
            navigator.clipboard.writeText(content).then(function() {
                alert('Code copié dans le presse-papiers !');
            });
        });
        
        // Fonction pour prévisualiser
        document.getElementById('previewButton').addEventListener('click', function() {
            const content = document.getElementById('generatedContent').textContent;
            const iframe = document.getElementById('previewFrame');
            const modal = new bootstrap.Modal(document.getElementById('previewModal'));
            
            iframe.srcdoc = content;
            modal.show();
        });

        // Toggle debug info
        document.getElementById('toggleDebug').addEventListener('click', function() {
            const debugInfo = document.getElementById('debugInfo');
            if (debugInfo.style.display === 'none') {
                debugInfo.style.display = 'block';
                this.textContent = 'Cacher les détails';
            } else {
                debugInfo.style.display = 'none';
                this.textContent = 'Voir les détails de réponse';
            }
        });
    </script>
</body>
</html>
